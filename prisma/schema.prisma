generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


// --- ACCOUNTING ---

model Account {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  type          String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  journalItems  JournalItem[]
  productsIncome Product[]     @relation("IncomeAccount")
  productsExpense Product[]    @relation("ExpenseAccount")
  productsStock  Product[]     @relation("StockAccount")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Journal {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique // VEN, ACH, CAI, MISC
  entries       JournalEntry[]
}

model JournalEntry {
  id            String         @id @default(cuid())
  date          DateTime       @default(now())
  reference     String?
  journalId     String
  journal       Journal        @relation(fields: [journalId], references: [id])
  items         JournalItem[]
  createdAt     DateTime       @default(now())
}

model JournalItem {
  id            String         @id @default(cuid())
  entryId       String
  entry         JournalEntry   @relation(fields: [entryId], references: [id])
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  partnerId     String?
  partner       Partner?       @relation(fields: [partnerId], references: [id])
  label         String
  debit         Decimal        @default(0) @db.Decimal(15, 2)
  credit        Decimal        @default(0) @db.Decimal(15, 2)
}

// --- CRM & PARTNERS ---

model Partner {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  isCustomer    Boolean        @default(true)
  isSupplier    Boolean        @default(false)
  sales         Sale[]
  purchases     Purchase[]
  journalItems  JournalItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// --- INVENTORY ---

model Category {
  id            String         @id @default(cuid())
  name          String
  products      Product[]
}

model Product {
  id                String         @id @default(cuid())
  name              String
  sku               String?        @unique
  barcode           String?        @unique
  description       String?
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id])
  salePrice         Decimal        @default(0) @db.Decimal(15, 2)
  costPrice         Decimal        @default(0) @db.Decimal(15, 2)
  stockQty          Float          @default(0)
  
  // Accounting integration
  incomeAccountId   String?
  incomeAccount     Account?       @relation("IncomeAccount", fields: [incomeAccountId], references: [id])
  expenseAccountId  String?
  expenseAccount    Account?       @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  stockAccountId    String?
  stockAccount      Account?       @relation("StockAccount", fields: [stockAccountId], references: [id])

  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  stockMoves        StockMove[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Warehouse {
  id            String         @id @default(cuid())
  name          String
  location      String?
  stockMoves    StockMove[]
}

model StockMove {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  qty           Float
  type          String         // IN, OUT, ADJUST
  reference     String?
  date          DateTime       @default(now())
}

// --- SALES & PURCHASES ---

model Sale {
  id            String         @id @default(cuid())
  number        String         @unique // SO-0001
  date          DateTime       @default(now())
  partnerId     String
  partner       Partner        @relation(fields: [partnerId], references: [id])
  items         SaleItem[]
  totalAmount   Decimal        @default(0) @db.Decimal(15, 2)
  status        String         @default("DRAFT") // DRAFT, POSTED, CANCELLED
}

model SaleItem {
  id            String         @id @default(cuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  qty           Float
  price         Decimal        @db.Decimal(15, 2)
  subtotal      Decimal        @db.Decimal(15, 2)
}

model Purchase {
  id            String         @id @default(cuid())
  number        String         @unique // PO-0001
  date          DateTime       @default(now())
  partnerId     String
  partner       Partner        @relation(fields: [partnerId], references: [id])
  items         PurchaseItem[]
  totalAmount   Decimal        @default(0) @db.Decimal(15, 2)
  status        String         @default("DRAFT")
}

model PurchaseItem {
  id            String         @id @default(cuid())
  purchaseId    String
  purchase      Purchase       @relation(fields: [purchaseId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  qty           Float
  price         Decimal        @db.Decimal(15, 2)
  subtotal      Decimal        @db.Decimal(15, 2)
}

// --- HR & PAYROLL ---

model Employee {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  jobTitle      String?
  baseSalary    Decimal        @default(0) @db.Decimal(15, 2)
  attendances   Attendance[]
  payrolls      Payroll[]
  createdAt     DateTime       @default(now())
}

model Attendance {
  id            String         @id @default(cuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  checkIn       DateTime
  checkOut      DateTime?
  date          DateTime       @default(now())
}

model Payroll {
  id            String         @id @default(cuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  month         Int
  year          Int
  grossSalary   Decimal        @db.Decimal(15, 2)
  netSalary     Decimal        @db.Decimal(15, 2)
  taxAmount     Decimal        @db.Decimal(15, 2)
  status        String         @default("DRAFT")
}
